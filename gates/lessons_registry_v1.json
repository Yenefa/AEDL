        "tests/test_learning_gate.py::LearningGateTests::test_fault_injection_runner_catches_all_five_reproductions",
        "tests/test_run_gates.py::RunGatesTests::test_delivery_gate_rejects_stale_self_consistent_bom_and_pos",
