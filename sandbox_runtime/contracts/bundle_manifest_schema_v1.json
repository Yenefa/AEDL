{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aedl.local/schemas/edd001-sandbox/bundle-manifest-v1.json",
  "title": "EDD-001 sandbox bundle manifest v1",
  "description": "Agent L ownership. Validators in aedl_sandbox.trust enforce exactly these constraints; this file is the declarative contract they implement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "domain_id", "board_id", "scope_status", "evidence_status",
    "execution_status", "verification_status", "approval_status", "files",
    "mirror_sets", "missing_requirements", "tool_coverage", "notes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "domain_id": { "type": "string", "minLength": 1 },
    "board_id": { "type": "string", "minLength": 1 },
    "scope_status": { "enum": ["DRAFT", "FROZEN"] },
    "evidence_status": { "enum": ["MISSING", "PARTIAL", "COMPLETE", "INVALID"] },
    "execution_status": { "enum": ["NOT_READY", "READY", "RUNNING", "COMPLETE", "FAILED", "BLOCKED"] },
    "verification_status": { "enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"] },
    "approval_status": { "enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "REJECTED"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "repo_path", "size_bytes", "sha256", "source_class", "required"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "repo_path": { "type": "string", "pattern": "^[^\\\\]*$|^$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "source_class": { "enum": ["VERIFIED_SOURCE", "UNVERIFIED_SOURCE", "MODEL_PRIOR", "HUMAN_INPUT"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "mirror_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authoritative_path", "mirror_path", "expected_equal"],
        "properties": {
          "authoritative_path": { "type": "string", "minLength": 1 },
          "mirror_path": { "type": "string", "minLength": 1 },
          "expected_equal": { "const": true }
        }
      }
    },
    "missing_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "reason_code", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "reason_code": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tool_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilers", "verifiers"],
      "properties": {
        "compilers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verifiers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  }
}
