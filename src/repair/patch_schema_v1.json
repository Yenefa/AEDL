{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aedl.invalid/schemas/repair/patch_schema_v1.json",
  "title": "AEDL PR-1 Repair Proposal Schema v1",
  "description": "Frozen external interface spec for the PR-1 single-round repair transaction (Implementation Contract v1). The host enforces this with an explicit recursive closed-field validator in tools/repair_pipeline.py; no generic schema engine is used at runtime. This document intentionally carries no per-case topology answers.",
  "schema_version": 1,
  "classification": "HOST_ONLY",
  "x-aedl-conventions": {
    "unknown_field": "REJECT",
    "duplicate_keys": "REJECT",
    "nan_or_infinity": "REJECT",
    "float_literals": "REJECT",
    "bool_as_integer": "REJECT",
    "max_request_bytes": 65536,
    "max_json_depth": 12,
    "min_ops": 1,
    "max_ops": 8,
    "max_diagnosis_entries": 16,
    "max_text_chars": 2048,
    "identifier": "^[A-Za-z0-9_-]{1,64}$",
    "sha256": "^[0-9a-f]{64}$",
    "canonical_json": "UTF-8, keys sorted lexicographically, compact separators, no ASCII escaping, no floats, sets sorted by stable identity, ordered lists keep their order",
    "digest": "SHA256(UTF8('AEDL-PR1:' + kind + ':1\\u0000') + canonical_json_bytes)",
    "digest_kinds": [
      "manifest",
      "proposal",
      "patch",
      "policy-bound",
      "topology",
      "delta",
      "protected",
      "toolchain",
      "context",
      "receipt"
    ]
  },
  "x-aedl-forbidden-proposal-fields": [
    "applied",
    "verdict",
    "verification_pass",
    "accepted",
    "signed_by",
    "snapshot_path",
    "authorization_ref",
    "policy_ref",
    "exception_id",
    "expected_delta"
  ],
  "public_op_schema": {
    "protocol_version": 2,
    "target_format": "kicad",
    "min_ops": 1,
    "max_ops": 8,
    "operations": [
      {
        "op": "delete_object",
        "required": ["op", "uuid"],
        "optional": {},
        "constraints": [
          "uuid must resolve to exactly one host-bound net label or wire",
          "no match selectors, no cascade, no wildcard"
        ]
      },
      {
        "op": "add_net_label",
        "required": ["op", "name", "at"],
        "optional": { "scope": ["local"], "rotation": [0] },
        "defaults": { "scope": "local" },
        "constraints": [
          "at must be a REF.PIN anchor, never a coordinate or expression",
          "scope is normalised to its default above before the proposal digest is computed",
          "rotation presence is preserved and is execution-semantic: an omitted rotation stays omitted and means the native pin-derived orientation, while an explicit rotation:0 stays explicit; the two have different canonical Proposal identity and must never be normalised into each other",
          "place_component rotation/mirror/unit keep their default normalisation; this rule applies to add_net_label.rotation only"
        ]
      },
      {
        "op": "place_component",
        "required": ["op", "lib_id", "designator", "x_mil", "y_mil", "value", "footprint"],
        "optional": { "rotation": [0], "mirror": ["none"], "unit": [1] },
        "defaults": { "rotation": 0, "mirror": "none", "unit": 1 },
        "lib_id_allowed": ["Device:R", "Device:C"],
        "constraints": [
          "coordinates are integer mil and must equal the host-granted placement",
          "no symbol_source, extra library paths, sheets, groups, instance_designators or shell/python escapes",
          "omitted optional fields are normalised to the defaults above before the proposal digest is computed"
        ]
      }
    ]
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Bounded ASCII identifier. Booleans and numbers are never accepted as identifiers."
    },
    "SHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex SHA256 over raw file bytes or over a canonical JSON digest."
    },
    "CandidateRelativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
      "description": "Candidate-relative POSIX path. No drive letters, UNC, ADS, dot segments, empty segments, trailing dot or space, and no reserved device names."
    },
    "BoundedText": {
      "type": "string",
      "maxLength": 2048,
      "description": "UTF-8 text with no control characters (code points < 0x20 and 0x7F rejected)."
    },
    "PinAnchor": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z0-9_]+$",
      "maxLength": 128,
      "description": "REF.PIN anchor for a net label. Coordinates and expressions are rejected."
    },
    "RefDesignator": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
      "description": "Component reference designator."
    },
    "RequirementLevel": {
      "type": "string",
      "enum": ["MANDATORY", "RECOMMENDED", "MARGIN", "UNKNOWN"]
    },
    "DiagnosisEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "observed", "fact_ids", "requirement_level", "rationale"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/BoundedText" },
        "observed": { "$ref": "#/$defs/BoundedText" },
        "fact_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "requirement_level": { "$ref": "#/$defs/RequirementLevel" },
        "rationale": { "$ref": "#/$defs/BoundedText" }
      },
      "description": "Diagnosis labels only. rule_id never maps to an execution authorisation and never influences route, delta or commit."
    },
    "Refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "missing_fact_ids", "explanation", "required_human_decision"],
      "properties": {
        "reason_code": { "$ref": "#/$defs/BoundedText" },
        "missing_fact_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "explanation": { "$ref": "#/$defs/BoundedText" },
        "required_human_decision": { "$ref": "#/$defs/BoundedText" }
      }
    },
    "DeleteObjectOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "uuid"],
      "properties": {
        "op": { "const": "delete_object" },
        "uuid": { "$ref": "#/$defs/Id" }
      }
    },
    "AddNetLabelOp": {
      "type": "object",
      "additionalProperties": false,
      "description": "The presence of 'rotation' is execution-semantic: omitting it means the native pin-derived orientation, while an explicit 0 writes 0. The two are different canonical Proposal identities and must not be normalised into each other.",
      "required": ["op", "name", "at"],
      "properties": {
        "op": { "const": "add_net_label" },
        "name": { "$ref": "#/$defs/BoundedText" },
        "at": { "$ref": "#/$defs/PinAnchor" },
        "scope": { "const": "local" },
        "rotation": { "const": 0, "description": "When present it must be 0 and stays explicit in the parsed Proposal; when absent it stays absent." }
      }
    },
    "PlaceComponentOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "lib_id", "designator", "x_mil", "y_mil", "value", "footprint"],
      "properties": {
        "op": { "const": "place_component" },
        "lib_id": { "enum": ["Device:R", "Device:C"] },
        "designator": { "$ref": "#/$defs/RefDesignator" },
        "x_mil": { "type": "integer" },
        "y_mil": { "type": "integer" },
        "value": { "$ref": "#/$defs/BoundedText" },
        "footprint": { "$ref": "#/$defs/BoundedText" },
        "rotation": { "const": 0 },
        "mirror": { "const": "none" },
        "unit": { "const": 1 }
      }
    },
    "Operation": {
      "oneOf": [
        { "$ref": "#/$defs/DeleteObjectOp" },
        { "$ref": "#/$defs/AddNetLabelOp" },
        { "$ref": "#/$defs/PlaceComponentOp" }
      ],
      "description": "Only the three primitives required by the five adjudicated cases are open. Arbitrary native ops are not reachable from a proposal."
    },
    "Oplist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "target_format", "ops"],
      "properties": {
        "protocol_version": { "const": 2 },
        "target_format": { "const": "kicad" },
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/Operation" }
        }
      }
    },
    "Proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "context_id",
        "target",
        "base_source_sha256",
        "decision",
        "diagnosis"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "context_id": { "$ref": "#/$defs/Id" },
        "target": { "$ref": "#/$defs/CandidateRelativePath" },
        "base_source_sha256": { "$ref": "#/$defs/SHA256" },
        "decision": { "enum": ["PATCH", "REFUSE"] },
        "diagnosis": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/DiagnosisEntry" }
        },
        "oplist": { "$ref": "#/$defs/Oplist" },
        "refusal": { "$ref": "#/$defs/Refusal" }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "PATCH" } }, "required": ["decision"] },
          "then": { "required": ["oplist"], "not": { "required": ["refusal"] } }
        },
        {
          "if": { "properties": { "decision": { "const": "REFUSE" } }, "required": ["decision"] },
          "then": { "required": ["refusal"], "not": { "required": ["oplist"] } }
        }
      ],
      "not": {
        "anyOf": [
          { "required": ["applied"] },
          { "required": ["verdict"] },
          { "required": ["verification_pass"] },
          { "required": ["accepted"] },
          { "required": ["signed_by"] },
          { "required": ["snapshot_path"] },
          { "required": ["authorization_ref"] },
          { "required": ["policy_ref"] },
          { "required": ["exception_id"] },
          { "required": ["expected_delta"] }
        ],
        "description": "A proposal can never self-assert execution effect, authorisation or an expected topology."
      }
    },
    "PublicContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "context_id",
        "target",
        "base_source_sha256",
        "current_observation",
        "public_facts",
        "generic_op_schema",
        "limits"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "context_id": { "$ref": "#/$defs/Id" },
        "target": { "$ref": "#/$defs/CandidateRelativePath" },
        "base_source_sha256": { "$ref": "#/$defs/SHA256" },
        "current_observation": { "type": ["object", "null"] },
        "public_facts": { "type": ["object", "array", "null"] },
        "generic_op_schema": { "type": "object" },
        "limits": { "type": "object" }
      },
      "description": "Whitelist projection handed to the proposer. It never carries host policy rules, bound rule ids, route, expected topology, authorised delta or internal report paths."
    },
    "PublicFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "proposal_outcome", "reason_code", "observed_issue_ids"],
      "properties": {
        "context_id": { "$ref": "#/$defs/Id" },
        "proposal_outcome": {
          "enum": [
            "APPLIED_TO_CANDIDATE",
            "NO_CHANGE",
            "REFUSED",
            "REJECTED",
            "EXECUTION_UNAVAILABLE"
          ]
        },
        "reason_code": {
          "enum": [
            "OK",
            "PROPOSAL_INVALID",
            "REPAIR_NOT_AUTHORIZED",
            "REPAIR_CONSTRAINT_VIOLATION",
            "INPUT_CHANGED",
            "EXECUTION_UNAVAILABLE"
          ]
        },
        "observed_issue_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        }
      }
    },
    "Phase": {
      "type": "string",
      "enum": ["PRECHECK", "SNAPSHOT", "STAGE_APPLY", "DELTA_CHECK", "KICAD_VERIFY", "COMMIT"]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "object_id", "detail"],
      "properties": {
        "code": { "type": "string" },
        "stage": { "$ref": "#/$defs/Phase" },
        "object_id": { "type": ["string", "null"] },
        "detail": { "type": "string" }
      },
      "description": "Host-only finding. Never serialised into public feedback."
    },
    "FileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "role"],
      "properties": {
        "path": { "$ref": "#/$defs/CandidateRelativePath" },
        "sha256": { "$ref": "#/$defs/SHA256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "role": {
          "enum": ["TARGET", "READONLY_DEPENDENCY", "REPORT", "NATIVE_ARTIFACT"]
        }
      }
    },
    "FileManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "files"],
      "properties": {
        "version": { "const": 1 },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/FileEntry" }
        }
      }
    },
    "ToolchainManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "akcli",
        "python",
        "kicad",
        "libraries",
        "configs",
        "execution"
      ],
      "properties": {
        "version": { "const": 1 },
        "akcli": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sdist_sha256", "package_files_sha256"],
          "properties": {
            "version": { "type": "string" },
            "sdist_sha256": { "$ref": "#/$defs/SHA256" },
            "package_files_sha256": { "$ref": "#/$defs/FileManifest" }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "executable_sha256"],
          "properties": {
            "version": { "type": "string" },
            "executable_sha256": { "$ref": "#/$defs/SHA256" }
          }
        },
        "kicad": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "executable_sha256"],
          "properties": {
            "version": { "type": "string" },
            "executable_sha256": { "$ref": "#/$defs/SHA256" }
          }
        },
        "libraries": { "$ref": "#/$defs/FileManifest" },
        "configs": { "$ref": "#/$defs/FileManifest" },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worker_timeout_seconds", "kicad_timeout_seconds", "argv_profile"],
          "properties": {
            "worker_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
            "kicad_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
            "argv_profile": { "const": "PR1_V1" }
          }
        }
      }
    },
    "BoundPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "rule_id",
        "route",
        "policy_file_sha256",
        "authority_context_digest",
        "before_source_sha256",
        "before_topology_sha256",
        "pin_identity_map",
        "object_identity_map",
        "captured_partitions",
        "new_component_roles",
        "expected_after",
        "authorized_delta",
        "authorized_delta_sha256",
        "protected_projection_sha256",
        "operation_constraints"
      ],
      "properties": {
        "version": { "const": 1 },
        "rule_id": { "type": "string" },
        "route": { "enum": ["STRICT", "CONSTRAINED_EXCEPTION"] },
        "policy_file_sha256": { "$ref": "#/$defs/SHA256" },
        "authority_context_digest": { "$ref": "#/$defs/SHA256" },
        "before_source_sha256": { "$ref": "#/$defs/SHA256" },
        "before_topology_sha256": { "$ref": "#/$defs/SHA256" },
        "pin_identity_map": { "type": "object" },
        "object_identity_map": { "type": "object" },
        "captured_partitions": { "type": "object" },
        "new_component_roles": { "type": "object" },
        "expected_after": { "type": "object" },
        "authorized_delta": { "type": "object" },
        "authorized_delta_sha256": { "$ref": "#/$defs/SHA256" },
        "protected_projection_sha256": { "$ref": "#/$defs/SHA256" },
        "operation_constraints": { "type": "object" }
      }
    },
    "HostPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "candidate_id",
        "round_id",
        "patch_id",
        "context_id",
        "proposal",
        "proposal_sha256",
        "target",
        "base",
        "policy",
        "authority",
        "toolchain_manifest",
        "toolchain_sha256",
        "route",
        "bound_policy",
        "patch_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "run_id": { "$ref": "#/$defs/Id" },
        "candidate_id": { "$ref": "#/$defs/Id" },
        "round_id": { "type": "integer", "minimum": 0 },
        "patch_id": { "$ref": "#/$defs/Id" },
        "context_id": { "$ref": "#/$defs/Id" },
        "proposal": { "$ref": "#/$defs/Proposal" },
        "proposal_sha256": { "$ref": "#/$defs/SHA256" },
        "target": { "$ref": "#/$defs/CandidateRelativePath" },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "topology_sha256"],
          "properties": {
            "files": { "$ref": "#/$defs/FileManifest" },
            "topology_sha256": { "$ref": "#/$defs/SHA256" }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "file_sha256", "bound_rule_id", "bound_policy_sha256"],
          "properties": {
            "id": { "$ref": "#/$defs/Id" },
            "file_sha256": { "$ref": "#/$defs/SHA256" },
            "bound_rule_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "bound_policy_sha256": { "$ref": "#/$defs/SHA256" }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context_digest", "resolved_authorization_refs", "decisions"],
          "properties": {
            "context_digest": { "$ref": "#/$defs/SHA256" },
            "resolved_authorization_refs": {
              "type": "array",
              "items": { "$ref": "#/$defs/Id" },
              "uniqueItems": true
            },
            "decisions": {
              "type": "array",
              "items": { "$ref": "#/$defs/AuthorityDecision" }
            }
          }
        },
        "toolchain_manifest": { "$ref": "#/$defs/ToolchainManifest" },
        "toolchain_sha256": { "$ref": "#/$defs/SHA256" },
        "route": { "enum": ["STRICT", "CONSTRAINED_EXCEPTION"] },
        "bound_policy": { "$ref": "#/$defs/BoundPolicy" },
        "patch_sha256": { "$ref": "#/$defs/SHA256" }
      },
      "description": "Constructed by the pipeline only. No field of a HostPatch may be merged in from a proposal JSON document."
    },
    "AuthorityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "allowed", "ref"],
      "properties": {
        "action": { "type": "string" },
        "allowed": { "type": "boolean" },
        "ref": { "$ref": "#/$defs/Id" }
      }
    },
    "StageApplyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "txn_id",
        "patch_sha256",
        "bound_policy_sha256",
        "route",
        "tool",
        "before_source_sha256",
        "after_source_sha256",
        "changed",
        "native_before",
        "native_after",
        "raw_artifacts",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": ["APPLIED_TO_STAGE", "BLOCKED", "TOOL_ERROR", "UNKNOWN"]
        },
        "txn_id": { "$ref": "#/$defs/Id" },
        "patch_sha256": { "$ref": "#/$defs/SHA256" },
        "bound_policy_sha256": { "$ref": "#/$defs/SHA256" },
        "route": { "enum": ["STRICT", "CONSTRAINED_EXCEPTION"] },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "version", "artifact_sha256", "exit_code", "tool_applied", "op_results", "connectivity_findings"],
          "properties": {
            "mode": { "enum": ["CLI", "PYTHON_WRITER"] },
            "version": { "type": "string" },
            "artifact_sha256": { "$ref": "#/$defs/SHA256" },
            "exit_code": { "type": ["integer", "null"] },
            "tool_applied": { "type": ["boolean", "null"] },
            "op_results": {
              "type": "array",
              "items": { "$ref": "#/$defs/OpResult" }
            },
            "connectivity_findings": {
              "type": "array",
              "items": { "$ref": "#/$defs/ConnectivityFinding" }
            }
          }
        },
        "before_source_sha256": { "$ref": "#/$defs/SHA256" },
        "after_source_sha256": { "$ref": "#/$defs/SHA256" },
        "changed": { "type": "boolean" },
        "native_before": { "type": ["object", "null"] },
        "native_after": { "type": ["object", "null"] },
        "raw_artifacts": { "$ref": "#/$defs/FileManifest" },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/Finding" } }
      }
    },
    "OpResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op_index", "op", "status", "created_uuids", "error_code", "message"],
      "properties": {
        "op_index": { "type": "integer", "minimum": 0 },
        "op": { "type": "string" },
        "status": { "enum": ["ok", "error"] },
        "created_uuids": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "error_code": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] }
      }
    },
    "ConnectivityFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL", "UNKNOWN"] },
        "message": { "type": "string" }
      }
    },
    "TransactionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "candidate_id",
        "round_id",
        "patch_id",
        "txn_id",
        "status",
        "last_phase",
        "cause_status",
        "proposal_sha256",
        "patch_sha256",
        "policy_sha256",
        "bound_policy_sha256",
        "toolchain_sha256",
        "initial_snapshot_id",
        "round_snapshot_id",
        "before_design_manifest",
        "staged_design_manifest",
        "final_design_manifest",
        "stage_result",
        "delta_check",
        "thin_verification",
        "commit",
        "rollback",
        "background_blockers",
        "full_verification_status",
        "formal_evidence_status",
        "raw_artifacts",
        "reasons",
        "replay_of"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "run_id": { "$ref": "#/$defs/Id" },
        "candidate_id": { "$ref": "#/$defs/Id" },
        "round_id": { "type": "integer", "minimum": 0 },
        "patch_id": { "$ref": "#/$defs/Id" },
        "txn_id": { "$ref": "#/$defs/Id" },
        "status": {
          "enum": [
            "COMMITTED",
            "NO_CHANGE",
            "REFUSED",
            "ROLLBACK",
            "BLOCKED",
            "TOOL_ERROR",
            "UNKNOWN"
          ]
        },
        "last_phase": { "$ref": "#/$defs/Phase" },
        "cause_status": { "enum": ["BLOCKED", "TOOL_ERROR", "UNKNOWN", null] },
        "proposal_sha256": { "$ref": "#/$defs/SHA256" },
        "patch_sha256": { "$ref": "#/$defs/SHA256" },
        "policy_sha256": { "$ref": "#/$defs/SHA256" },
        "bound_policy_sha256": { "$ref": "#/$defs/SHA256" },
        "toolchain_sha256": { "$ref": "#/$defs/SHA256" },
        "initial_snapshot_id": { "$ref": "#/$defs/Id" },
        "round_snapshot_id": { "$ref": "#/$defs/Id" },
        "before_design_manifest": { "$ref": "#/$defs/FileManifest" },
        "staged_design_manifest": { "type": ["object", "null"] },
        "final_design_manifest": { "$ref": "#/$defs/FileManifest" },
        "stage_result": { "type": ["object", "null"] },
        "delta_check": { "type": ["object", "null"] },
        "thin_verification": { "type": ["object", "null"] },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempted", "replaced", "verified"],
          "properties": {
            "attempted": { "type": "boolean" },
            "replaced": { "type": "boolean" },
            "verified": { "type": "boolean" }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "attempted", "byte_equal", "reasons"],
          "properties": {
            "status": { "enum": ["NOT_NEEDED", "VERIFIED", "FAILED", "UNKNOWN"] },
            "attempted": { "type": "boolean" },
            "byte_equal": { "type": ["boolean", "null"] },
            "reasons": { "type": "array", "items": { "$ref": "#/$defs/Finding" } }
          }
        },
        "background_blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "$ref": "#/$defs/Id" },
              "status": { "type": "string" }
            }
          }
        },
        "full_verification_status": { "const": "NOT_RUN" },
        "formal_evidence_status": { "const": "NOT_RUN" },
        "raw_artifacts": { "$ref": "#/$defs/FileManifest" },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        "replay_of": { "type": ["string", "null"] }
      },
      "description": "PR-1 local transaction receipt. It is never published as a formal VerifierPort PASS and never promotes a candidate."
    }
  }
}
